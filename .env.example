# Dono: proposed configuration names, not a working runtime configuration.
# Every value is deliberately blank. Fill .env.local only; never commit secrets.
# See docs/setup.md. Choose ONE reviewed Supabase key pair before scaffolding.

# Browser-visible project URL and recommended publishable key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only elevated key, if the selected server commands require it.
SUPABASE_SECRET_KEY=

# Legacy compatibility pair from the earlier design. Leave unused unless chosen.
# These names do not imply that an application fallback has been implemented.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Server-only analysis settings. Required MVP provider value: openai.
# Select and verify a vision/structured-output model before setting OPENAI_MODEL.
OPENAI_API_KEY=
OPENAI_MODEL=
ANALYSIS_PROVIDER=

# Optional S1 only; leave blank for the required OpenAI-only MVP.
TYPESAFE_API_KEY=

# Proposed server-only settings, to bind during implementation.
# Exact local origin for the chosen session / same-origin checks.
APP_ORIGIN=
# A separate locally generated signing secret; never reuse a Supabase/provider key.
QR_SIGNING_KEY=
# Private bucket name chosen during Storage provisioning.
DONATION_PHOTOS_BUCKET=
# Current official geocoder base URL; resolve AMB-021 before setting this.
GEOCODING_BASE_URL=

# Upload limits, timezone/expiry rules, quantity/season rules, QR lifetime,
# retention, timeouts and retry windows are unresolved policy/config decisions.
# No guessed values or invented runtime switches are supplied here.
