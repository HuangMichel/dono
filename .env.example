# Dono configuration reference. FastAPI reads its backend settings.
# All values are blank placeholders. See docs/setup.md.
# Use an ignored root .env or separate frontend/backend environment settings.
# Never put server keys in NEXT_PUBLIC settings.

# FRONTEND PUBLIC SETTINGS ONLY -> root .env / frontend/.env.local / Vercel
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_API_BASE_URL=

# FASTAPI SETTINGS ONLY -> root .env / backend/.env / Vercel API project
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Elevated server credential; never copy it into the frontend.
SUPABASE_SECRET_KEY=
# Required baseline provider is openai; choose a verified compatible model.
OPENAI_API_KEY=
OPENAI_MODEL=
ANALYSIS_PROVIDER=
# Optional Jev S1 only; leave blank for the required OpenAI baseline.
TYPESAFE_API_KEY=
# Exact allowed frontend origin, not an invented port or wildcard.
APP_ORIGIN=
# Separate server-only QR signing secret; do not reuse provider/Supabase keys.
QR_SIGNING_KEY=
# Images persist as base64 text in private.photo_contents; no bucket setting.
# Government BAN through IGN: selected base https://data.geopf.fr/geocodage/
GEOCODING_BASE_URL=

# Operational offer/booking/unit/season defaults: docs/domain-model.md.
# Approved defaults: JPEG/PNG/WebP, 4 MiB, 3 photos, 20 MP; provider 60s, lease 120s.
# Shelf-life: expiry-v1. Retention and deployment budgets remain open.
# No guessed values, legacy credential fallback or backend secrets in Next.js.
