{
  "schema_version": 1,
  "diagram_type": "erd",
  "meta": {
    "title": "Dono — Proposed Database Schema",
    "output": "docs/architecture/database-erd.html",
    "quality_profile": "standard",
    "locale": "en",
    "views": [
      {
        "id": "access",
        "label": "Identity and access",
        "focus": [
          "profiles",
          "associations",
          "association_members",
          "auth_users"
        ],
        "note": "Platform capability and scoped membership are distinct; no client role escalation."
      },
      {
        "id": "intake",
        "label": "Intake and matching",
        "focus": [
          "capacity",
          "needs",
          "donations",
          "donation_photos"
        ],
        "note": "Current facts and explicit units; availability is computed while parent locks are held."
      },
      {
        "id": "evidence",
        "label": "AI evidence vs human edits",
        "focus": [
          "donation_analysis",
          "donation_indicators",
          "expiry_info",
          "donation_edits",
          "donations"
        ],
        "note": "AI originals stay immutable; typed working dates and corrections remain separate."
      },
      {
        "id": "reception",
        "label": "Booking and stock",
        "focus": [
          "slots",
          "bookings",
          "inventory_movements",
          "api_requests",
          "donations"
        ],
        "note": "Scoped composite FKs, locked capacity/slots and durable idempotency prevent duplicate effects."
      }
    ]
  },
  "layout": {
    "mode": "grid",
    "entityW": 290,
