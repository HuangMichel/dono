  "cards": [
    {
      "dot": "amber",
      "title": "Proposed design, not migrations",
      "items": [
        "All 13 required tables plus photos, correction history and private idempotency support.",
        "DB-P01–DB-P07 in docs/databases.md are provisional where product decisions remain open.",
        "Every application column is shown; auth.users shows only its externally referenced key."
      ]
    },
    {
      "dot": "violet",
      "title": "Evidence and expiry",
      "items": [
        "Original category/extracted JSON/indicators/confidence/provider/model never change after donor corrections.",
        "Working donation facts + expiry_info and append-only donation_edits preserve correction provenance.",
        "Days left, expired flag, buckets and FEFO are read-time calculations; no derived expiry columns."
      ]
    },
    {
      "dot": "rose",
      "title": "RLS and human authority",
      "items": [
        "Donors own their items; members read target-association records. Platform admins approve associations only.",
        "Direct product DML is denied; guarded atomic commands enforce column ownership and transitions.",
        "Only authorized staff write donation decision; no model is in the matching or acceptance path."
      ]
    },
    {
      "dot": "emerald",
      "title": "Relationships and constraints",
      "items": [
        "Each FK role has a separate relationship; applicant/approver and donor/reviewer are distinct, with their own optionality.",
        "Composite same-association / same-donation constraints are specified in databases.md.",
        "api_requests.resource_id and JSON input-photo snapshots are not SQL foreign keys.",
        "reg. = registered_by (applicant); approver, donor and reviewer are separate FK roles.",
        "PK/UK badges mean participation in a key; composite groups are listed in databases.md, not individual-column uniqueness."
      ]
    }
  ]
}
