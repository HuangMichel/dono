  "cards": [
    {
      "dot": "cyan",
      "title": "UML-style participation, not chronological flow",
      "items": [
        "Human actors sit outside Dono; named use-case cards sit inside its boundary. Arrows show participation/dependency.",
        "Admin/staff specialize the shared review/reception role; staff management rights remain AMB-001.",
        "All protected use cases require authenticated authorization, not just the illustrated sign-in association."
      ]
    },
    {
      "dot": "violet",
      "title": "Evidence and human authority",
      "items": [
        "Scan/correct includes original provider/model/category + immutable indicators and separate working facts.",
        "A donor category override shows potential mismatch. Neither AI provider participates in the review decision."
      ]
    },
    {
      "dot": "amber",
      "title": "Supporting and non-participating actors",
      "items": [
        "OpenAI and the donor are repeated for readability; repeated boxes denote the same actor.",
        "Jev/operator are optional/deployment actors, not new product roles. Supabase is supporting infrastructure.",
        "Redirect destinations are references only; beneficiaries have no MVP account or system interaction."
      ]
    },
    {
      "dot": "rose",
      "title": "Boundary and unresolved permissions",
      "items": [
        "Registration bootstrap is AMB-002; platform admins approve associations, not donations.",
        "No transport, routing, email or messaging actor/integration is added.",
        "Shared persistence supports all scoped records; one illustrative relation avoids suggesting unrestricted data access."
      ]
    }
  ]
