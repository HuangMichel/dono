      "type": "external",
      "label": "Staff",
      "sublabel": "target association"
    }
  ],
  "segments": [
    {
      "from": 210,
      "to": 821,
      "label": "1 · Book an approved offer — one available slot allocation"
    },
    {
      "from": 861,
      "to": 1207,
      "label": "2 · Today’s arrivals — physical donor drop-off, no transport service"
    },
    {
      "from": 1247,
      "to": 2013,
      "label": "3 · QR validation then explicit staff reception — single stock effect"
    }
  ],
  "messages": [
    {
      "id": "slot-request",
      "from": "donor-ui",
      "to": "api",
      "y": 226,
      "label": "Read slots",
      "variant": "security"
    },
    {
      "id": "approved-check",
      "from": "api",
      "to": "db",
      "y": 274,
      "label": "Own approved offer",
      "variant": "security"
    },
    {
      "id": "slot-data",
      "from": "db",
      "to": "api",
      "y": 322,
      "label": "Available slots",
      "variant": "return"
    },
    {
      "id": "slot-results",
      "from": "api",
      "to": "donor-ui",
      "y": 370,
      "label": "Slots + location",
      "variant": "return"
    },
    {
      "id": "select-slot",
      "from": "donor",
      "to": "donor-ui",
      "y": 418,
      "label": "Choose drop-off",
      "variant": "default"
    },
    {
      "id": "book-request",
      "from": "donor-ui",
      "to": "api",
      "y": 466,
      "label": "Book slot",
      "variant": "security"
    },
    {
      "id": "atomic-book",
      "from": "api",
      "to": "db",
      "y": 514,
      "label": "Guard + reserve",
      "variant": "security",
      "note": "Check owner, staff approval and target association; reserve an available slot consistently. Last-slot contention cannot overbook. Slot policy: AMB-010/AMB-011."
    },
    {
      "id": "booking-commit",
      "from": "db",
      "to": "api",
      "y": 635,
      "label": "Booking / conflict",
      "variant": "return"
    },
    {
      "id": "booking-qr",
      "from": "api",
      "to": "donor-ui",
      "y": 683,
      "label": "Booking + QR",
      "variant": "return",
      "note": "On successful booking, issue a QR tied to that booking. Conflict returns availability, not a success QR. Payload/lifetime: AMB-013."
    },
    {
      "id": "donor-appointment",
      "from": "donor-ui",
      "to": "donor",
      "y": 793,
      "label": "Appointment + QR",
      "variant": "return"
    },
    {
      "id": "today-open",
      "from": "staff",
      "to": "staff-ui",
      "y": 877,
      "label": "Open today list",
      "variant": "default"
    },
    {
      "id": "today-request",
      "from": "staff-ui",
      "to": "api",
      "y": 925,
      "label": "Read arrivals",
      "variant": "security"
    },
    {
      "id": "today-scope",
      "from": "api",
      "to": "db",
      "y": 973,
      "label": "Membership + date",
      "variant": "security"
    },
    {
      "id": "today-rows",
      "from": "db",
      "to": "api",
      "y": 1021,
      "label": "Scoped bookings",
      "variant": "return"
    },
    {
      "id": "today-list",
      "from": "api",
      "to": "staff-ui",
      "y": 1069,
      "label": "Today’s arrivals",
      "variant": "return"
    },
    {
      "id": "physical-qr",
      "from": "donor",
      "to": "staff",
      "y": 1117,
      "label": "At drop-off: QR",
      "variant": "emphasis",
      "note": "The donor brings the item to the association. This is physical presentation, not a messaging or transport integration."
    },
    {
      "id": "scan",
      "from": "staff",
      "to": "staff-ui",
      "y": 1263,
      "label": "Scan QR",
      "variant": "default"
    },
    {
      "id": "validate-qr",
      "from": "staff-ui",
      "to": "api",
      "y": 1311,
      "label": "Validate booking",
      "variant": "security"
    },
    {
      "id": "booking-guards",
      "from": "api",
      "to": "db",
      "y": 1359,
      "label": "Check QR + scope",
      "variant": "security",
      "note": "Validate token/booking, target membership, approval and current state. Possession of a QR alone grants no authority."
    },
    {
      "id": "qr-result",
      "from": "db",
      "to": "api",
      "y": 1469,
      "label": "Booking / invalid",
      "variant": "return"
    },
    {
      "id": "resolved-item",
      "from": "api",
      "to": "staff-ui",
      "y": 1517,
      "label": "Item / current state",
      "variant": "return",
      "note": "Foreign, invalid or already-received bookings cannot add stock. A valid scan identifies the item; it does not itself confirm receipt."
    },
    {
      "id": "physical-check",
      "from": "staff",
      "to": "staff-ui",
      "y": 1627,
      "label": "Confirm received",
      "variant": "emphasis"
    },
    {
      "id": "confirm-receive",
      "from": "staff-ui",
      "to": "api",
      "y": 1675,
      "label": "Record reception",
      "variant": "security"
    },
    {
      "id": "atomic-reception",
      "from": "api",
      "to": "db",
      "y": 1723,
      "label": "Receive once",
      "variant": "security",
      "note": "Atomically validate state and record received stock/staff attribution. Apply agreed need/capacity effects once; retries cannot duplicate movements. AMB-008."
    },
    {
      "id": "received-commit",
      "from": "db",
      "to": "api",
      "y": 1833,
      "label": "Received / existing",
      "variant": "return"
    },
    {
      "id": "reception-confirm",
      "from": "api",
      "to": "staff-ui",
      "y": 1881,
      "label": "Reception state",
      "variant": "return"
    },
    {
      "id": "donor-refresh",
      "from": "donor-ui",
      "to": "api",
      "y": 1929,
      "label": "Read own status",
      "variant": "security"
    },
    {
      "id": "donor-received",
      "from": "api",
      "to": "donor-ui",
      "y": 1977,
      "label": "Received in-app",
      "variant": "return"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "Booking · FR-023",
      "items": [
        "Only the donor’s approved offer can book the target association’s slot.",
        "Appointment and QR are retrievable inside the app; no email confirmation."
      ]
    },
    {
      "dot": "rose",
      "title": "Reception · FR-024 / FR-025",
      "items": [
        "Authenticated target-association personnel validate the QR and explicitly confirm actual receipt.",
        "Duplicate/foreign/invalid scans create no duplicate stock or capacity/need effects."
      ]
    },
    {
      "dot": "amber",
      "title": "Open policies",
      "items": [
        "AMB-008/010/011/013: units, reservation timing, timezone, cancellation, token lifetime, late arrivals and partial reception.",
        "These are logical interactions, not a mandated endpoint or token design. Distribution is a separate staff action (UC-012)."
      ]
    }
  ]
}
