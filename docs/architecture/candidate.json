  "cards": [
    {
      "dot": "cyan",
      "title": "One Next.js application",
      "items": [
        "Three role-specific views share route handlers / server actions.",
        "Human personnel alone approve or refuse donations; platform approval concerns associations."
      ]
    },
    {
      "dot": "violet",
      "title": "Evidence and overrides · FR-010 / FR-011",
      "items": [
        "Original provider, model, AI category, extracted facts, indicators and confidence stay unchanged.",
        "Human working category/attributes are separate; show category mismatch with original evidence."
      ]
    },
    {
      "dot": "emerald",
      "title": "Matching and expiry · BR-002 / BR-003",
      "items": [
        "Need + capacity + season + Haversine distance: code only, no model in matching.",
        "Expiry days, buckets and FEFO are computed at read time, never stored."
      ]
    },
    {
      "dot": "rose",
      "title": "Intake rules · BR-004 / BR-005",
      "items": [
        "Medicines cannot be donated: high medicine indicator warns and points to a pharmacy.",
        "Individual food is non-perishable and room-temperature; chilled/frozen concern warns."
      ]
    },
    {
      "dot": "amber",
      "title": "Forty-hour scope",
      "items": [
        "Required: auth/RLS, indicators, expiry buckets/FEFO, review, booking and QR reception.",
        "Jev is optional; image requests need TypeSafe-Danger-Zone-Images: true.",
        "No transport, route optimization, email or messaging. Status remains in-app."
      ]
    },
    {
      "dot": "slate",
      "title": "Design evidence and open policies",
      "items": [
        "Target design from AGENTS.md, requirements.md and features.md; no implemented runtime is claimed.",
        "Capacity timing, post-offer edits, expiry boundaries and auth bootstrap remain AMB decisions."
      ]
    }
  ]
